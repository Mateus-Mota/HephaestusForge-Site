---
import fs from 'node:fs';
import path from 'node:path';
import { RELEASE } from '../data/release';

interface Props {
  lang?: 'en' | 'pt';
}

const { lang = 'en' } = Astro.props;
const screenshotPublicPath = '/screenshots/studios-workbench.png';
const screenshotDiskPath = path.join(process.cwd(), 'public', 'screenshots', 'studios-workbench.png');
const hasScreenshot = fs.existsSync(screenshotDiskPath);
const catalogBase = lang === 'pt' ? '/pt/guide/studios-catalog/' : '/guide/studios-catalog/';
const dialogId = `forge-lightbox-${lang}`;

const copy =
  lang === 'pt'
    ? {
        windowTitle: `HephaestusForge ${RELEASE.version} — Oficina de Estúdios (37 ferramentas integradas)`,
        placeholderTitle: 'Espaço reservado para o print real da Oficina de Estúdios',
        placeholderBody:
          'Salve sua captura em public/screenshots/studios-workbench.png para exibi-la automaticamente aqui.',
        zoomHint: 'Clique para ampliar',
        closeLabel: 'Fechar visualização (Esc)',
        blocks: [
          {
            title: 'Arte 2D & Shaders',
            desc: 'Sprites, Tilemap Collision, Skeleton2D, Partículas e Shader VFX',
            href: `${catalogBase}#bloco-a--arte-2d-sprites--animação`,
          },
          {
            title: 'Áudio & SFX',
            desc: 'Sintetizador WebAudio (.wav), Chiptune Tracker e Audio Bus Mixer',
            href: `${catalogBase}#bloco-b--áudio-sfx--música`,
          },
          {
            title: 'Combate & Gameplay',
            desc: 'Frame Data, Hitbox/Hurtbox, Skill Tree, Loot Table e FSM/BT',
            href: `${catalogBase}#bloco-c--combate-gameplay--ia`,
          },
          {
            title: 'Mundo & HUD',
            desc: 'HUD responsivo, Dungeons, Parallax 2D, Zonas de Câmera e Diálogos',
            href: `${catalogBase}#bloco-e--interface-hud--controles`,
          },
        ],
      }
    : {
        windowTitle: `HephaestusForge ${RELEASE.version} — Studios Workbench (37 built-in tools)`,
        placeholderTitle: 'Real Studios Workbench screenshot slot',
        placeholderBody:
          'Drop your screenshot at public/screenshots/studios-workbench.png to render it automatically here.',
        zoomHint: 'Click to zoom',
        closeLabel: 'Close preview (Esc)',
        blocks: [
          {
            title: '2D Art & Shaders',
            desc: 'Sprites, Tilemap Collision, Skeleton2D, Particles & Shader VFX',
            href: `${catalogBase}#block-a--2d-art-sprites--animation`,
          },
          {
            title: 'Audio & SFX',
            desc: 'WebAudio Synthesizer (.wav), Chiptune Tracker & Audio Bus Mixer',
            href: `${catalogBase}#block-b--audio-sfx--music`,
          },
          {
            title: 'Combat & Gameplay',
            desc: 'Frame Data, Hitbox/Hurtbox, Skill Tree, Loot Table & FSM/BT',
            href: `${catalogBase}#block-c--combat-gameplay--ai`,
          },
          {
            title: 'World & HUD',
            desc: 'Responsive HUD, Dungeons, 2D Parallax, Camera Zones & Dialogues',
            href: `${catalogBase}#block-e--ui-hud--controls`,
          },
        ],
      };
---

<div class="forge-showcase">
  <div class="forge-showcase__bar">
    <div class="forge-showcase__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <span class="forge-showcase__title">{copy.windowTitle}</span>
    <span class="forge-showcase__meta">Godot 4 • File-over-App</span>
  </div>

  <div class="forge-showcase__frame">
    {hasScreenshot ? (
      <button
        type="button"
        class="forge-showcase__zoom-btn"
        data-lightbox-open={dialogId}
        aria-label={copy.zoomHint}
      >
        <img src={screenshotPublicPath} alt={copy.windowTitle} loading="eager" />
        <span class="forge-showcase__zoom-pill">{copy.zoomHint}</span>
      </button>
    ) : (
      <div class="forge-showcase__placeholder">
        <strong>{copy.placeholderTitle}</strong>
        <p style="margin: 0.5rem 0 0; font-size: 0.85rem; color: var(--sl-color-gray-3);">
          {copy.placeholderBody}
        </p>
      </div>
    )}
  </div>

  <div class="forge-showcase__grid">
    {copy.blocks.map((block) => (
      <a class="forge-showcase__pill" href={block.href}>
        <strong>{block.title}</strong>
        <span>{block.desc}</span>
      </a>
    ))}
  </div>
</div>

{hasScreenshot && (
  <dialog id={dialogId} class="forge-lightbox" aria-label={copy.windowTitle}>
    <div class="forge-lightbox__bar">
      <span>{copy.windowTitle}</span>
      <button type="button" class="forge-lightbox__close" data-lightbox-close={dialogId}>
        {copy.closeLabel}
      </button>
    </div>
    <img src={screenshotPublicPath} alt={copy.windowTitle} />
  </dialog>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]').forEach((btn) => {
    const id = btn.dataset.lightboxOpen;
    if (!id) return;
    const dialog = document.getElementById(id) as HTMLDialogElement | null;
    if (!dialog) return;

    btn.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.querySelector(`[data-lightbox-close="${id}"]`)?.addEventListener('click', () => {
      dialog.close();
    });
  });
</script>
